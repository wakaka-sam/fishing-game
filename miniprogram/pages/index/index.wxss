* {
  box-sizing: border-box;
}

.login-screen {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a3a5c 0%, #0d1421 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.login-box {
  width: 100%;
  max-width: 620rpx;
  background: #1a1a2e;
  border: 8rpx solid #ffd700;
  padding: 56rpx 44rpx;
  text-align: center;
  box-shadow: 0 0 0 8rpx #0d1421, 0 0 0 14rpx #ffd700;
}

.app-icon {
  width: 132rpx;
  height: 132rpx;
  margin-bottom: 18rpx;
}

.login-title {
  display: block;
  color: #ffd700;
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.login-copy,
.login-hint {
  display: block;
  color: #d6d6d6;
  font-size: 26rpx;
}

.login-hint {
  margin-top: 22rpx;
  font-size: 22rpx;
  opacity: 0.62;
}

.login-input,
.redeem-input {
  height: 76rpx;
  margin: 28rpx auto;
  padding: 0 24rpx;
  background: #10172a;
  border: 4rpx solid #ffd700;
  color: #f0e68c;
  font-size: 28rpx;
  text-align: center;
}

.login-input {
  width: 420rpx;
}

.error-msg {
  display: block;
  color: #ff7043;
  font-size: 24rpx;
  margin-top: 18rpx;
}

.game-screen {
  min-height: 100vh;
  padding: 18rpx 18rpx 140rpx;
  background: #0d1421;
}

.topbar,
.gamebar {
  width: 100%;
  max-width: 760rpx;
  margin: 0 auto 14rpx;
  padding: 16rpx;
  background: #1a1a2e;
  border: 4rpx solid #ffd700;
}

.topbar {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.user-info,
.actions,
.bait-info,
.row {
  display: flex;
  align-items: center;
}

.user-info,
.actions {
  flex-wrap: wrap;
  gap: 12rpx;
}

.player-name {
  color: #4ec9b0;
  font-size: 30rpx;
  font-weight: 700;
}

.money {
  color: #ffd700;
}

.diamonds {
  color: #66e6ff;
}

.version-tag {
  color: #8a8f99;
  font-size: 20rpx;
}

.tool-btn,
.shop-item button,
.tabs button,
.row button {
  min-height: 52rpx;
  line-height: 52rpx;
  padding: 0 18rpx;
  margin: 0;
  background: #2c3e50;
  color: #ffd700;
  border: 3rpx solid #ffd700;
  border-radius: 0;
  font-size: 23rpx;
}

.tool-btn.logout {
  color: #ddd;
  border-color: #666;
}

.vip-auto {
  border-color: #66e6ff;
  color: #66e6ff;
}

.vip-auto.is-enabled {
  background: #0f4c5c;
  border-color: #4ec9b0;
  color: #fff;
}

.vip-auto.is-running {
  background: #0b6b5f;
  border-color: #ffd700;
}

.primary {
  min-height: 68rpx;
  line-height: 68rpx;
  padding: 0 28rpx;
  margin: 0;
  background: #d35400;
  color: #fff;
  border: 4rpx solid #ffae42;
  border-radius: 0;
  font-size: 28rpx;
}

.primary[disabled],
.cast-btn[disabled],
.row button[disabled] {
  opacity: 0.45;
}

.primary.small {
  min-height: 52rpx;
  line-height: 52rpx;
  font-size: 23rpx;
  padding: 0 18rpx;
}

.primary.big {
  min-width: 280rpx;
  min-height: 84rpx;
  line-height: 84rpx;
}

.game-canvas {
  display: block;
  margin: 0 auto;
  background: #87ceeb;
  border: 8rpx solid #ffd700;
}

.gamebar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.bait-info {
  gap: 14rpx;
  flex-wrap: wrap;
  justify-content: center;
  color: #e8e8e8;
  font-size: 25rpx;
}

.picker-value {
  min-width: 230rpx;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 18rpx;
  background: #10172a;
  border: 3rpx solid #ffd700;
  color: #f0e68c;
}

.bait-count,
.status {
  color: #4ec9b0;
}

.rod-info {
  color: #cbd5e1;
  font-size: 23rpx;
  text-align: center;
  line-height: 1.45;
}

.cast-btn {
  width: 360rpx;
}

.status {
  min-height: 38rpx;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.45;
}

.sync-status {
  color: #8a8f99;
  font-size: 22rpx;
  text-align: center;
}

.mobile-action-btn {
  position: fixed;
  left: 50%;
  bottom: 34rpx;
  transform: translateX(-50%);
  width: 164rpx;
  height: 164rpx;
  border: 6rpx solid #ffd700;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 700;
  font-size: 30rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.45);
  z-index: 40;
}

.overlay,
.hitbar-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.76);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 34rpx;
}

.modal {
  width: 100%;
  max-width: 680rpx;
  max-height: 86vh;
  overflow-y: auto;
  background: #1a1a2e;
  border: 8rpx solid #ffd700;
  padding: 36rpx 24rpx 30rpx;
  position: relative;
}

.modal.wide {
  max-width: 720rpx;
}

.close-x {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 58rpx;
  height: 58rpx;
  line-height: 52rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  color: #ddd;
  border: 2rpx solid #666;
  border-radius: 0;
  font-size: 36rpx;
  z-index: 3;
}

.modal-title {
  color: #ffd700;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.hitbar-overlay {
  z-index: 120;
  flex-direction: column;
  gap: 30rpx;
}

.hitbar-info {
  text-align: center;
}

.hitbar-msg {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hitbar-progress {
  color: #4ec9b0;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.hitbar-timer {
  color: #ff7043;
  font-size: 26rpx;
}

.hitbar {
  width: 620rpx;
  max-width: 92vw;
  height: 58rpx;
  background: #2c3e50;
  border: 5rpx solid #ffd700;
  position: relative;
  overflow: hidden;
}

.hitbar-zone {
  position: absolute;
  top: 0;
  bottom: 0;
  background: linear-gradient(90deg, #d35400, #ff5722, #d35400);
  border-left: 3rpx solid #fff;
  border-right: 3rpx solid #fff;
}

.hitbar-cursor {
  position: absolute;
  top: -4rpx;
  bottom: -4rpx;
  width: 6rpx;
  background: #fff;
  box-shadow: 0 0 12rpx #fff;
}

.ad-reward-box,
.shop-item,
.dex-item,
.rod-item,
.character-item,
.pet-item,
.accessory-item,
.rank-row,
.gacha-result,
.accessory-catalog,
.dex-stats,
.accessory-summary,
.accessory-empty {
  background: #0d1421;
  border: 3rpx solid #555;
}

.ad-reward-box {
  padding: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.ad-title {
  color: #ffd700;
  font-size: 28rpx;
  margin-bottom: 6rpx;
}

.ad-desc,
.desc,
.muted {
  color: rgba(232, 232, 232, 0.72);
  font-size: 22rpx;
  line-height: 1.45;
}

.shop-list,
.rod-list,
.character-list,
.pet-list,
.accessory-list,
.gacha-result-items {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.shop-item,
.rod-item,
.character-item,
.pet-item,
.accessory-item {
  width: calc(50% - 7rpx);
  padding: 16rpx;
}

.shop-head,
.rod-name,
.character-name,
.pet-name,
.accessory-name {
  font-size: 27rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.row {
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 14rpx;
  color: #ffd700;
  font-size: 23rpx;
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.tabs button {
  flex: 1;
  min-width: 128rpx;
}

.tabs button.active {
  background: #ffd700;
  color: #1a1a2e;
}

.dex-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.dex-item {
  width: calc(33.333% - 7rpx);
  padding: 12rpx 8rpx;
  min-height: 178rpx;
  text-align: center;
}

.dex-item.locked {
  opacity: 0.48;
}

.dex-icon {
  display: block;
  font-size: 44rpx;
  line-height: 54rpx;
}

.dex-name,
.dex-info,
.dex-stats text {
  display: block;
}

.dex-name {
  font-size: 22rpx;
  font-weight: 700;
  margin: 4rpx 0;
}

.dex-info {
  color: rgba(232, 232, 232, 0.78);
  font-size: 19rpx;
  line-height: 1.35;
}

.dex-stats {
  margin-top: 16rpx;
  padding: 14rpx;
  color: #d7dee8;
  font-size: 23rpx;
  line-height: 1.6;
}

.result-fish {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 10rpx;
  padding: 18rpx 0;
}

.result-icon {
  font-size: 74rpx;
}

.result-name {
  font-size: 38rpx;
  font-weight: 700;
}

.result-rarity,
.result-reward {
  font-size: 26rpx;
}

.result-line {
  color: #d7dee8;
  font-size: 25rpx;
}

.result-reward {
  color: #ffd700;
}

.result-bottom-close,
.retry-btn {
  margin: 18rpx auto 0;
}

.rod-preview {
  height: 70rpx;
  position: relative;
  margin-bottom: 10rpx;
}

.rod-line {
  position: absolute;
  left: 22rpx;
  top: 34rpx;
  width: 200rpx;
  height: 10rpx;
  transform: rotate(15deg);
  transform-origin: left center;
}

.rod-line-light {
  top: 31rpx;
  height: 4rpx;
}

.rod-item.active,
.character-item.active,
.pet-item.active,
.accessory-item.active {
  border-color: #ffd700;
  box-shadow: inset 0 0 0 2rpx rgba(255, 215, 0, 0.35);
}

.rod-item.locked,
.character-item.locked,
.pet-item.locked {
  opacity: 0.58;
}

.rod-desc,
.rod-req,
.character-title,
.character-bio,
.pet-desc,
.pet-ability,
.badge,
.accessory-effect {
  color: rgba(232, 232, 232, 0.72);
  font-size: 21rpx;
  line-height: 1.4;
}

.rod-req,
.badge,
.pet-ability {
  color: #ffae42;
  margin-top: 8rpx;
}

.character-stage {
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.character-stage image {
  width: 148rpx;
  height: 118rpx;
  image-rendering: pixelated;
}

.character-fallback {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-width: 5rpx;
  border-style: solid;
  font-size: 42rpx;
}

.pet-icon {
  display: block;
  text-align: center;
  font-size: 58rpx;
}

.accessory-list {
  display: flex;
  flex-direction: column;
}

.accessory-list .accessory-item {
  width: 100%;
}

.gacha-item {
  width: calc(50% - 7rpx);
}

.accessory-summary,
.accessory-empty,
.accessory-catalog {
  padding: 16rpx;
  margin-bottom: 16rpx;
  color: #d7dee8;
  font-size: 24rpx;
}

.accessory-status {
  min-height: 36rpx;
  color: #4ec9b0;
  font-size: 23rpx;
  margin-bottom: 12rpx;
}

.accessory-status.fail {
  color: #ff7043;
}

.accessory-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.accessory-icon {
  font-size: 46rpx;
}

.stars {
  color: #ffd700;
  font-size: 21rpx;
}

.accessory-catalog {
  margin-top: 16rpx;
  line-height: 1.5;
}

.rank-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.rank-row {
  padding: 18rpx;
  display: flex;
  justify-content: space-between;
  color: #d7dee8;
}

.rank-reward-banner {
  color: #ffd700;
  background: rgba(255, 215, 0, 0.12);
  border: 2rpx solid rgba(255, 215, 0, 0.5);
  padding: 16rpx;
  margin-bottom: 16rpx;
  text-align: center;
  font-size: 23rpx;
}

.gacha-prizes {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.gacha-prize {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  border: 2rpx solid #555;
  background: #0d1421;
  padding: 12rpx;
  color: #d7dee8;
  font-size: 23rpx;
}

.gacha-buttons {
  display: flex;
  justify-content: center;
  gap: 14rpx;
}

.gacha-result {
  margin-top: 18rpx;
  padding: 16rpx;
}

.gacha-item {
  min-height: 118rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #10172a;
  border: 2rpx solid #555;
  color: #d7dee8;
  font-size: 21rpx;
  text-align: center;
}

.gi-icon {
  font-size: 44rpx;
}

.gi-ultimate,
.ultimate {
  border-color: #ff7ac8;
  color: #ffb7df;
}

.gi-legendary,
.legendary {
  border-color: #c586c0;
  color: #f0b7eb;
}

.gi-rare,
.rare,
.gi-accessory {
  border-color: #4ec9b0;
  color: #8df0dd;
}

.gi-diamond,
.diamond-prize {
  border-color: #66e6ff;
  color: #9bf0ff;
}

.gi-coin,
.coin-prize {
  border-color: #ffd700;
  color: #ffe783;
}

.gacha-summary,
.redeem-status,
.share-status {
  margin-top: 14rpx;
  color: #ffd700;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.45;
}

.redeem-content,
.share-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
  text-align: center;
  color: #d7dee8;
}

.redeem-input {
  width: 420rpx;
  margin: 8rpx auto;
}

.redeem-status.error {
  color: #ff7043;
}

.redeem-status.success,
.share-status.success {
  color: #4ec9b0;
}

.share-qr {
  width: 360rpx;
  height: 480rpx;
  border: 3rpx solid #555;
}

.announce-content {
  max-height: 65vh;
}

.announce-entry {
  margin-bottom: 18rpx;
}

.announce-version {
  color: #ffd700;
  font-weight: 700;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.announce-version text {
  color: #8a8f99;
  font-size: 21rpx;
  margin-left: 10rpx;
}

.announce-line {
  color: #d7dee8;
  font-size: 23rpx;
  line-height: 1.55;
}

@media (min-width: 900px) {
  .game-screen {
    padding-bottom: 28rpx;
  }

  .mobile-action-btn {
    right: 44rpx;
    left: auto;
    transform: none;
  }
}
